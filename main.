local function placeRandCFrame(usedPositions)
    local _, pen = findPlot()
    if not pen then return nil end
    local w  = pen.Size
    local rx = math.max(4, w.X/2 - 5)
    local rz = math.max(4, w.Z/2 - 5)
    for _ = 1, 60 do
        local ox  = math.random(-math.floor(rx), math.floor(rx))
        local oz  = math.random(-math.floor(rz), math.floor(rz))
        local cf  = pen.CFrame * CFrame.new(ox, w.Y/2 + 1, oz)
        local ok  = true
        for _, up in usedPositions do
            if (up - cf.Position).Magnitude < 5.5 then ok = false; break end
        end
        if ok then return cf end
    end
    return pen.CFrame * CFrame.new(math.random(-8, 8), w.Y/2 + 1, math.random(-8, 8))
end

local function placeAllEggs()
    local _, _, origin = findPlot()
    if not origin or not RF_PlaceEgg then return 0 end
    local placed = 0
    local usedPos = {}

    local function tryPlace(uid)
        local cf = placeRandCFrame(usedPos)
        if not cf then return end
        local localCF = origin.CFrame:ToObjectSpace(cf)
        local ok, res = pcall(function() return RF_PlaceEgg:InvokeServer({Uid = uid, LocalCFrame = localCF}) end)
        if ok and res ~= false then
            placed += 1
            table.insert(usedPos, cf.Position)
        end
    end

    -- from snapshot
    if RF_LiveSnapshot then
        local ok, res = pcall(function() return RF_LiveSnapshot:InvokeServer() end)
        if ok and type(res) == "table" then
            for _, slot in pairs(res) do
                if type(slot) == "table" and slot.OwnerUserId == lp.UserId then
                    for uid, data in pairs(slot.Records or {}) do
                        if not data.Placement then tryPlace(uid) end
                    end
                end
            end
        end
    end

    -- from inventory
    local function tryFromContainer(container)
        if not container then return end
        for _, obj in container:GetChildren() do
            if isEggTool(obj) then
                local uid = obj:GetAttribute("UID") or obj:GetAttribute("EggUid") or obj.Name
                tryPlace(uid)
                task.wait(0.04)
            end
        end
    end
    tryFromContainer(lp.Character)
    tryFromContainer(lp:FindFirstChild("Backpack"))
    return placed
end

local function hatchAllReady(forced)
    if (not forced and not h.autoHatch) or not RF_Hatch or not RF_FinishHatch or not RF_LiveSnapshot then return 0 end
    if h.isHatching then return 0 end
    h.isHatching = true

    local ok, snap = pcall(function() return RF_LiveSnapshot:InvokeServer() end)
    if not ok or type(snap) ~= "table" then h.isHatching = false; return 0 end

    local ready = {}
    local now   = Workspace:GetServerTimeNow and Workspace:GetServerTimeNow() or os.time()

    for _, slot in pairs(snap) do
        if type(slot) == "table" and slot.OwnerUserId == lp.UserId then
            for uid, data in pairs(slot.Records or {}) do
                if not h.alive then break end
                if data.Placement then
                    local isReady = false
                    if EggState then
                        local fn = EggState.IsReadyToHatch or EggState.IsLocalEggReady
                        if fn then
                            local ok2, r2 = pcall(fn, uid)
                            if ok2 and type(r2) == "boolean" then isReady = r2 end
                        end
                    end
                    if not isReady then
                        local placed = data.Placement.PlacedAt or data.Placement.Time or 0
                        local grow   = 30
                        if AssetItems and AssetItems.Assets and AssetItems.Assets[data.AssetCategory] then
                            local a = AssetItems.Assets[data.AssetCategory]
                            grow = (a and a.Egg and a.Egg.GrowthTime) or 30
                        end
                        grow = grow / math.max(0.01, data.GrowthSpeedMultiplier or 1)
                        isReady = (now - placed) >= grow
                    end
                    if isReady then table.insert(ready, {uid = uid, cat = data.AssetCategory}) end
                end
            end
        end
    end

    local hatched = 0
    for _, egg in ready do
        task.spawn(function()
            local ok1, _ = pcall(function()
                if RF_Hatch:IsA("RemoteFunction") then return RF_Hatch:InvokeServer(egg.uid)
                else RF_Hatch:FireServer(egg.uid); return true end
            end)
            if ok1 then
                task.wait(0.9)
                local ok2, _ = pcall(function()
                    if RF_FinishHatch:IsA("RemoteFunction") then return RF_FinishHatch:InvokeServer(egg.uid)
                    else RF_FinishHatch:FireServer(egg.uid); return true end
                end)
                if ok2 then hatched += 1 end
            end
        end)
        task.wait(0.04)
    end

    task.wait(0.95)
    h.isHatching = false
    return hatched
end

local function depositAll(speed, sessionCheck)
    local _, _, origin = findPlot()
    if not origin then return end
    local home = getPenPosition()
    if refreshChar() then
        local dist = (hrp.Position - home).Magnitude
        if dist > 8 then
            h.statusText = "[Deposit] Flying home..."
            tweenHome(speed or h.glideSpeed, sessionCheck, true)
        end
    end
    if not refreshChar() then return end
    spawnPad(home, 15)
    hrp.CFrame = CFrame.new(home)
    hrp.AssemblyLinearVelocity = Vector3.zero
    h.statusText = "[Deposit] Placing eggs..."
    local deadline = os.clock() + 3
    while countEggs() > 0 and os.clock() < deadline and h.alive do
        placeAllEggs(); task.wait(0.06)
    end
    h.statusText = "[Deposit] Hatching ready eggs..."
    hatchAllReady(true)
    pcall(unequipAll)
    h.isReturning = false; h.delivering = false
    h.statusText = string.format("Deposited! (%d eggs left)", countEggs())
end

