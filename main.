local function findRemote(primary, fallback)
    local net = (ReplicatedStorage:FindFirstChild("Packages") and
                 ReplicatedStorage.Packages:FindFirstChild("Networking"))
             or ReplicatedStorage:FindFirstChild("Network")
             or ReplicatedStorage

    local function search(name)
        if not name then return nil end
        return net:FindFirstChild(name)
            or ReplicatedStorage:FindFirstChild(name)
            or net:FindFirstChild(name, true)
            or ReplicatedStorage:FindFirstChild(name, true)
    end

    return search(primary)
        or search(fallback)
        or (primary and search(primary:match("[^/]+$")))
        or nil
end

