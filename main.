local function addSlider(page, title, min_, max_, default, step, onChange)
    local card = makeCard(page, 62)

    local titleLbl = label(card, title, 12, PAL.text, Enum.Font.GothamBold)
    titleLbl.Position = UDim2.new(0, 12, 0, 6)
    titleLbl.Size     = UDim2.new(1, -70, 0, 18)

    local valLbl = label(card, tostring(default), 12, PAL.accent, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
    valLbl.Position = UDim2.new(1, -52, 0, 6)
    valLbl.Size     = UDim2.new(0, 40, 0, 18)

    local track = frame(card, Color3.fromRGB(35,35,55))
    track.Position = UDim2.new(0, 12, 0, 34)
    track.Size     = UDim2.new(1, -24, 0, 6)
    corner(track, 3)

    local fill = frame(track, PAL.accent)
    fill.Size     = UDim2.new((default - min_) / (max_ - min_), 0, 1, 0)
    fill.Position = UDim2.new(0, 0, 0, 0)
    corner(fill, 3)

    local knob = frame(card, Color3.fromRGB(255,255,255))
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Size     = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new(
        0,
        12 + ((card.Size.X.Offset - 24) * (default - min_) / (max_ - min_)),
        0,
        37
    )
    corner(knob, 7)

    local val = default
    local dragging = false

    local function setVal(px)
        local tw = track.AbsoluteSize.X
        if tw <= 0 then return end
        local pct = math.clamp((px - track.AbsolutePosition.X) / tw, 0, 1)
        val = min_ + math.round((max_ - min_) * pct / (step or 1)) * (step or 1)
        val = math.clamp(val, min_, max_)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        valLbl.Text = tostring(val)
        pcall(onChange, val)
    end

    local dragBtn = Instance.new("TextButton")
    dragBtn.BackgroundTransparency = 1
    dragBtn.Size   = UDim2.fromScale(1, 1)
    dragBtn.Text   = ""
    dragBtn.Parent = card

    dragBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true; setVal(inp.Position.X)
        end
    end)
    dragBtn.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
            setVal(inp.Position.X)
        end
    end)

    return card
end

