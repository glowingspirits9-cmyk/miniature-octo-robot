-- │  ZONE RESOLVER (from original Dk function)  │
-- └─────────────────────────────────────────────┘
local function resolveZone(areaId, pos, category)
    local a = (areaId or ""):lower()
    local c = (category or ""):lower()
    if a:find("light") and a:find("dark") then return "Light Dark" end
    if a:find("titan")   then return "Titan Temple"   end
    if a:find("cherry")  then return "Cherry Blossom" end
    if a:find("cosmic")  then return "Cosmic"         end
    if a:find("prehist") or a:find("dino") then return "Prehistoric" end
    if a:find("abyss")   or a:find("ocean") then return "Abyss Ocean" end
    if a:find("volcano") or a:find("lava")  then return "Volcano"     end
    if a:find("snow")    or a:find("ice")   then return "Snow"        end
    if a:find("jungle")  then return "Jungle"  end
    if a:find("desert")  or a:find("sand")  then return "Desert" end
    if a:find("lake")    or a:find("water") then return "Lake"   end
    if a:find("forest")  then return "Forest" end
    -- fallback: X position
    if pos then
        local x = pos.X
        if x >= 5200 then return "Light Dark"    end
        if x >= 4750 then return "Titan Temple"  end
        if x >= 4000 then return "Cherry Blossom" end
        if x >= 3350 then return "Cosmic"        end
        if x >= 2780 then return "Prehistoric"   end
        if x >= 2250 then return "Abyss Ocean"   end
        if x >= 1850 then return "Volcano"       end
        if x >= 1450 then return "Snow"          end
        if x >= 1150 then return "Jungle"        end
        if x >= 920  then return "Desert"        end
        if x >= 720  then return "Lake"          end
    end
    return "Forest"
end

