        return false
    end
end

-- ┌─────────────────────────────────────────────┐
-- │  WARP SNIPE SEQUENCE                        │
-- └─────────────────────────────────────────────┘
local function warpSnipe(egg, sessionCheck)
    if h.teleporting or h.glidingToTarget or h.delivering or h.securingEgg then return false end
    h.teleporting = true
    h.stateTime   = os.clock()

    local function abort(reason)
        h.statusText  = "[-] " .. reason
        h.teleporting = false
        resetState()
        return false
    end

    if not refreshChar() then return abort("No character") end
    if not h.swapped then swapHumanoid() end
    if h.godmode then applyGodmode(true) end
    fixCharacter(lp.Character)

    if not egg then egg = getBestEgg() end
    if not egg then return abort("No target found") end

    local targetCF  = egg.CFrame
    local uid       = egg.Uid
    local targetPos = targetCF.Position

    -- verify target is available
    if uid and snapshotCache then
        local avail = false
        for _, r in snapshotCache do
            if r.Uid == uid then
                if r.State == "Slot" or r.State == 1 or r.State == "Dropped" then
                    avail = true; break
                elseif (r.State == "Carried" or r.State == 2) and (r.CarrierUserId == lp.UserId) then
                    avail = true; break
                end
            end
        end
        if not avail then
            if uid then skipList[uid] = os.clock() + 5 end
            return abort("Target already taken")
        end
    end

    -- pick up Lake seed egg if we don't hold one
    local _, heldUid = getHeldEgg()
    if not heldUid then
        -- look for a Lake egg near base to use as carrier
        local lakeTarget = nil
        local all = getAllEggRecords(false)
        for _, r in all do
            if (r.State == "Slot" or r.State == 1 or r.State == "Dropped")
               and r.BoundsCFrame and r.BoundsCFrame.Position.X >= 530 then
                local zone = resolveZone(r.AreaId, r.BoundsCFrame.Position, r.AssetCategory)
                if zone == "Lake" then lakeTarget = r; break end
            end
        end

        if lakeTarget and lakeTarget.BoundsCFrame then
            local lakePos = lakeTarget.BoundsCFrame.Position
            spawnPad(lakePos, 8)
            h.statusText = "[Warp 1] Grabbing Lake seed egg..."
            h.holdingEggForGuard = true
            if refreshChar() and (hrp.Position - lakePos).Magnitude > 60 then
                local ok = tweenTo(lakePos, h.glideSpeed, lakeTarget.Uid, sessionCheck, 12)
                if not ok then h.holdingEggForGuard = false; return abort("Lake egg flight aborted") end
            elseif refreshChar() then
                hrp.CFrame = lakeTarget.BoundsCFrame * CFrame.new(0, 0.4, 0)
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
            -- pickup loop
            local pickup = os.clock() + 3
            local lastF  = 0
            while not isHoldingEgg() and os.clock() < pickup and h.alive and h.teleporting do
                firePrompts(lakeTarget.PhysicalModel, lakePos)
                if RF_CarryEgg and os.clock() - lastF > 0.35 then
                    lastF = os.clock()
                    pcall(function()
                        if RF_CarryEgg:IsA("RemoteFunction") then RF_CarryEgg:InvokeServer({Uid = lakeTarget.Uid})
                        else RF_CarryEgg:FireServer({Uid = lakeTarget.Uid}) end
                    end)
                end
                RunService.Heartbeat:Wait()
            end
            h.holdingEggForGuard = false
            if not isHoldingEgg() then return abort("Lake pickup failed") end
        end
    end

    _, heldUid = getHeldEgg()

    -- stream target area
    h.statusText = "[Warp 2] Streaming target..."
    pcall(function() lp:RequestStreamAroundAsync(targetPos) end)
    spawnPad(targetPos, 12)

    if not refreshChar() then return abort("Character lost") end
    hrp.Anchored = false
    if hum then hum:ChangeState(Enum.HumanoidStateType.Running) end
    hrp.AssemblyLinearVelocity  = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    task.wait(0.04)

    -- detect bounce from guard hit using held egg
    local startY   = hrp.Position.Y
    local startPos = hrp.Position
    h.holdingEggForGuard = true
    local _, curUid = getHeldEgg()

    -- fire guard toll to produce bounce
    if RE_GuardStrike then
        task.spawn(function()
            pcall(function()
                if RE_GuardStrike:IsA("RemoteFunction") then RE_GuardStrike:InvokeServer()
                else RE_GuardStrike:FireServer() end
            end)
        end)
    end

    local bounceDetected = false
    local bounceDeadline = os.clock() + 2.5
    local retried        = false
    while os.clock() < bounceDeadline and h.alive and h.teleporting do
        if sessionCheck and sessionId ~= sessionCheck then
            h.holdingEggForGuard = false
            return abort("Session switch at bounce")
        end
        local vel = hrp.AssemblyLinearVelocity
        local dy  = hrp.Position.Y - startY
        local dm  = (hrp.Position - startPos).Magnitude
        if os.clock() - (bounceDeadline - 2.5) >= 0.08 then
            if vel.Y >= 10 or dy >= 1.5 or dm >= 2 or vel.Magnitude >= 20 then
                bounceDetected = true; break
            end
        end
        if not retried and os.clock() - (bounceDeadline - 2.5) >= 0.5 then
            retried = true
            if RE_GuardStrike then
                task.spawn(function()
                    pcall(function()
                        if RE_GuardStrike:IsA("RemoteFunction") then RE_GuardStrike:InvokeServer()
                        else RE_GuardStrike:FireServer() end
                    end)
                end)
            end
        end
        RunService.Heartbeat:Wait()
    end
    h.holdingEggForGuard = false

    if not bounceDetected then
        pcall(unequipAll)
        return abort("No bounce — guard not triggered")
    end

    task.wait(0.05)

    -- re-verify target
    if uid and snapshotCache then
        local taken = false
        for _, r in snapshotCache do
            if r.Uid == uid and (r.State == "Carried" or r.State == 2)
               and r.CarrierUserId ~= lp.UserId then
                taken = true; break
            end
        end
        if taken then
            skipList[uid] = os.clock() + 5
            return abort("Target snatched during bounce")
        end
    end

    -- warp to target
    h.statusText = "[Warp 3] Warping to target..."
    spawnPad(targetPos, 8)
    lp.Character:PivotTo(targetCF * CFrame.new(0, 0.4, 0))
    hrp.Anchored = true
    for _, p in lp.Character:GetDescendants() do
        if p:IsA("BasePart") then p.AssemblyLinearVelocity = Vector3.zero end
    end

    -- clear inventory before guard strike
    local bp = lp:FindFirstChild("Backpack")
    for _, obj in lp.Character:GetChildren() do
        if obj:IsA("Tool") then
            pcall(function() obj.Parent = bp or Workspace end)
        end
    end
    task.wait(0.06)
    hrp.Anchored = false
    if hum then hum:ChangeState(Enum.HumanoidStateType.Running) end

    -- guard strike cycle
    local secured = guardStrike(uid, targetCF, egg.Model, sessionCheck)
    hrp.Anchored = false
    if hum then hum:ChangeState(Enum.HumanoidStateType.Running) end
    for _, p in lp.Character:GetDescendants() do
        if p:IsA("BasePart") then p.AssemblyLinearVelocity = Vector3.zero end
    end

    h.teleporting = false
    if not secured then return false end

    h.statusText = "[Warp Done] Egg secured!"
    pcall(unequipAll)
    return true
end

-- ┌─────────────────────────────────────────────┐
-- │  RETURN TO SAFE LINE                        │
-- └─────────────────────────────────────────────┘
local function returnToSafeLine(speed, sessionCheck)
    if not refreshChar() then return false end
    speed   = math.max(100, speed or h.glideSpeed)
    local safePos = Vector3.new(SAFE_X - 10, 70, h.laneZ or LANE_Z)
    local root    = hrp
    local hm      = hum
    if hm then hm.AutoRotate = false end

    h.isReturning = true
    spawnPad(Vector3.new(SAFE_X, 70, h.laneZ or LANE_Z), 20)
    pcall(unequipAll)
    root.AssemblyLinearVelocity = Vector3.zero

    local deadline = os.clock() + 15
    while h.alive and h.isReturning and os.clock() < deadline do
        if sessionCheck and sessionId ~= sessionCheck then
            h.isReturning = false
            if hm then hm.AutoRotate = true end
            return false
        end
        if not h.pureTweenFarm and not h.autoFarmLoop then
            h.isReturning = false
            if hm then hm.AutoRotate = true end
            return false
        end

        local pos  = root.Position
        local dist = (safePos - pos).Magnitude
        if pos.X <= SAFE_X + 10 or dist <= 6 then
            pcall(unequipAll); break
        end

        local dt  = RunService.Heartbeat:Wait()
        pos       = root.Position
        local laneZ = h.laneZ or LANE_Z
        local spd = speed
        if pos.X <= FIELD_X and pos.X > SAFE_X then
            local t = math.clamp((pos.X - SAFE_X) / (FIELD_X - SAFE_X), 0, 1)
            spd = SLOW_SPEED + (speed - SLOW_SPEED) * t
        elseif pos.X <= SAFE_X then spd = SLOW_SPEED end

        local moveX = pos.X + math.sign(safePos.X - pos.X) * math.min(math.abs(safePos.X - pos.X), spd * dt)
        local moveY = pos.Y + math.sign(safePos.Y - pos.Y) * math.min(math.abs(safePos.Y - pos.Y), spd * dt * 0.5)
        local moveZ = pos.Z + math.sign(laneZ - pos.Z) * math.min(math.abs(laneZ - pos.Z), spd * dt)

        for _, hb in getBossHitboxes() do
            local hp = hb.Position
            if (Vector3.new(moveX, moveY, moveZ) - hp).Magnitude < 22 then
                moveY = math.min(moveY + spd * dt * 1.5, hp.Y + 16); break
            end
        end

        local newPos = Vector3.new(moveX, moveY, moveZ)
        local look   = (newPos - pos).Magnitude > 0.05 and (newPos - pos).Unit or root.CFrame.LookVector
        root.CFrame  = CFrame.lookAt(newPos, newPos + look)
        root.AssemblyLinearVelocity  = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        h.statusText = string.format("Returning to Safe Line (%.0f st | X: %.0f)", dist, pos.X)
    end

    root.CFrame = CFrame.new(SAFE_X, math.max(68, root.Position.Y), h.laneZ or LANE_Z)
    root.AssemblyLinearVelocity = Vector3.zero
    if hm then hm.AutoRotate = true end
    pcall(unequipAll)
    h.isReturning = false; h.delivering = false; h.onTreadmill = false
    h.statusText  = "Safe Line reached — Hands Free"
    return true
end

