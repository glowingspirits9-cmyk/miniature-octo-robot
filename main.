local function findPlot()
    if h.plot and h.plot.Parent and h.pen and h.origin then
        return h.plot, h.pen, h.origin
    end
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil, nil, nil end

    local uid  = lp.UserId
    local name = lp.Name

    local function tryFromRemote()
        if RF_AskState then
            local ok, res = pcall(function() return RF_AskState:InvokeServer() end)
            if ok and type(res) == "table" and type(res.OwnersBySlot) == "table" then
                for slot, owner in pairs(res.OwnersBySlot) do
                    if owner == uid or tostring(owner) == tostring(uid) then
                        return plots:FindFirstChild(tostring(slot))
                    end
                end
            end
        end
        if RF_LiveSnapshot then
            local ok, res = pcall(function() return RF_LiveSnapshot:InvokeServer() end)
            if ok and type(res) == "table" then
                for k, v in pairs(res) do
                    if type(v) == "table" and (v.OwnerUserId == uid or tostring(v.OwnerUserId) == tostring(uid)) then
                        return plots:FindFirstChild(tostring(v.Slot or k)) or plots:FindFirstChild(tostring(k))
                    end
                end
            end
        end
    end

    local plot = tryFromRemote()

    if not plot then
        for _, p in plots:GetChildren() do
            local owner = p:GetAttribute("Owner") or p:GetAttribute("OwnerUserId") or p:GetAttribute("UserId")
            if owner and (owner == uid or tostring(owner) == tostring(uid) or owner == name) then
                plot = p; break
            end
        end
    end

    if not plot then
        -- closest plot to player
        local root = refreshChar() and hrp
        if root then
            local bestDist, bestPlot = 160, nil
            for _, p in plots:GetChildren() do
                local center = p:FindFirstChild("CenterPoint") or p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart")
                if center then
                    local d = (root.Position - center.Position).Magnitude
                    if d < bestDist then bestDist = d; bestPlot = p end
                end
            end
            plot = bestPlot
        end
    end

    if not plot then
        plot = plots:FindFirstChild("2") or plots:FindFirstChild("1") or plots:GetChildren()[1]
    end

    if not plot then return nil, nil, nil end

    h.plot   = plot
    h.origin = plot:FindFirstChild("CenterPoint")
    local toUpdate = plot:FindFirstChild("ToUpdate")
    h.pen    = (toUpdate and toUpdate:FindFirstChild("PetArea")) or plot:FindFirstChild("PetArea") or h.origin
    h.tread  = plot:FindFirstChild("TreadmillBottom")
    if not h.origin then h.origin = h.pen or plot.PrimaryPart end
    if not h.pen    then h.pen    = h.origin end
    return h.plot, h.pen, h.origin
end

local function getPenPosition()
    local _, pen, origin = findPlot()
    if pen    then return pen.Position    + Vector3.new(0, 3.5, 0) end
    if origin then return origin.Position + Vector3.new(0, 3.5, 0) end
    return Vector3.new(464.7, 71.7, -304)
end

