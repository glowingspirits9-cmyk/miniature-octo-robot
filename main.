local BATCH_SIZE = 5
local function onStealSuccess(mode)
    if not h.autoPlaceEvery5 then return false end
    h.batchStealCount = (h.batchStealCount or 0) + 1
    if h.batchStealCount >= BATCH_SIZE then
        h.batchStealCount = 0
        task.spawn(function()
            if h.isBatchPlacing then return end
            h.isBatchPlacing = true
            local sid = sessionId
            h.pureTweenFarm = false; h.autoFarmLoop = false
            depositAll(h.glideSpeed, sid)
            for i = BATCH_SIZE, 1, -1 do
                if not h.alive then break end
                h.statusText = string.format("[AutoPlace] Resuming in %ds...", i)
                task.wait(1)
            end
            h.isBatchPlacing = false
            if h.alive and sessionId == sid then
                if mode == "TWEEN" then h.pureTweenFarm = true
                elseif mode == "WARP" then h.autoFarmLoop = true end
            end
        end)
        return true
    end
    return false
end

-- ┌─────────────────────────────────────────────┐
-- │  TREADMILL                                  │
-- └─────────────────────────────────────────────┘
local function getTreadmillPad()
    if h.tread and h.tread.Parent then return h.tread end
    local plot = findPlot()
    if not plot then return nil end
    local tb = plot:FindFirstChild("TreadmillBottom") or plot:FindFirstChild("TreadmillBottom", true)
    if tb and tb:IsA("BasePart") then h.tread = tb; return tb end
    local tu = plot:FindFirstChild("TreadmillUpgrade", true)
    if tu then
        local lowest, lowestY = nil, math.huge
        for _, p in tu:GetDescendants() do
            if p:IsA("BasePart") and p.Position.Y < lowestY then
                lowest = p; lowestY = p.Position.Y
            end
        end
        if lowest then h.tread = lowest; return lowest end
    end
    return nil
end

local function isOnTreadmill()
    if h.onTreadmill then return true end
    if not refreshChar() then return false end
    local root = hrp
    local pad  = getTreadmillPad()
    if pad then
        local d = (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(pad.Position.X, pad.Position.Z)).Magnitude
        if d > 6 then return false end
    else
        if root.Position.X > 535 then return false end
    end
    local hm = hum
    if hm then
        for _, t in hm:GetPlayingAnimationTracks() do
            local id = t.Animation and t.Animation.AnimationId or ""
            if id:find("10921259953") or t.Name:lower():find("treadmill") then return true end
        end
    end
    return false
end

local function dismountTreadmill()
    h.onTreadmill = false
    if RF_TreadDoff then pcall(function() RF_TreadDoff:InvokeServer() end) end
    local c = lp.Character
    local hm = c and c:FindFirstChildOfClass("Humanoid")
    if hm then
        pcall(function()
            hm.PlatformStand = false; hm.Sit = false
            hm:SetStateEnabled(Enum.HumanoidStateType.Running, true)
            hm:ChangeState(Enum.HumanoidStateType.Running)
        end)
    end
    if refreshChar() then
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    fixCharacter(c)
end

local lastTreadmillAttempt = 0
local function mountTreadmill(sessionCheck)
    if h.onTreadmill then return true end
    if not refreshChar() then return false end
    if os.clock() - lastTreadmillAttempt < 0.8 then return false end
    lastTreadmillAttempt = os.clock()

    local pad = getTreadmillPad()
    if not pad then return false end

    -- enable pad touch
    pcall(function() pad.CanTouch = true; pad.CanCollide = true end)

    local padPos = pad.Position + Vector3.new(0, 1.8, 0)
    local root   = hrp

    -- fly to pad if needed
    if root.Position.X > 535 then
        returnToSafeLine(h.glideSpeed, sessionCheck)
        if sessionCheck and sessionId ~= sessionCheck then return false end
    end

    local hDist = (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(padPos.X, padPos.Z)).Magnitude
    if hDist > 4 then
        local spd = math.max(250, h.glideSpeed or 400)
        local deadline = os.clock() + 4
        while h.alive and (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(padPos.X, padPos.Z)).Magnitude > 4 and os.clock() < deadline do
            if sessionCheck and sessionId ~= sessionCheck then return false end
            local dt  = RunService.Heartbeat:Wait()
            local pos = root.Position
            local tgt = Vector3.new(padPos.X, 70, padPos.Z)
            local dir = (tgt - pos)
            local mv  = dir.Unit * math.min(dir.Magnitude, spd * dt)
            root.CFrame = CFrame.lookAt(pos + mv, pos + mv + (dir.Magnitude > 0.05 and dir.Unit or root.CFrame.LookVector))
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end

    -- align Y
    local yDeadline = os.clock() + 1.5
    while h.alive and math.abs(root.Position.Y - padPos.Y) > 2 and os.clock() < yDeadline do
        local dt  = RunService.Heartbeat:Wait()
        local pos = root.Position
        local dir = padPos - pos
        local mv  = dir.Unit * math.min(dir.Magnitude, 150 * dt)
        root.CFrame = CFrame.new(pos + mv)
        root.AssemblyLinearVelocity = Vector3.zero
    end

    root.CFrame = CFrame.new(padPos)
    root.AssemblyLinearVelocity = Vector3.zero

    -- fire touch
    if (root.Position - padPos).Magnitude <= 6 then
        pcall(function()
            if typeof(firetouchinterest) == "function" then
                firetouchinterest(root, pad, 0); task.wait(0.02); firetouchinterest(root, pad, 1)
            end
        end)
        for _, pp in pad:GetDescendants() do
            if pp:IsA("ProximityPrompt") and pp.Enabled then
                pcall(function() if typeof(fireproximityprompt) == "function" then fireproximityprompt(pp) end end)
            end
        end
        if RF_TreadDon then pcall(function() RF_TreadDon:InvokeServer() end) end
        h.onTreadmill = true
        h.statusText  = "[Treadmill] Running..."
        return true
    end

    h.onTreadmill = false
    return false
end

