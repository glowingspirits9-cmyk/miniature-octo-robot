-- │  RARITY RESOLVER                            │
-- └─────────────────────────────────────────────┘
local function resolveRarity(rec)
    local function check(s)
        s = (s or ""):lower()
        if s:find("divine")    then return 6,"Divine"    end
        if s:find("eternal")   then return 5,"Eternal"   end
        if s:find("secret")    then return 4,"Secret"    end
        if s:find("cosmic")    then return 3,"Cosmic"    end
        if s:find("mythic")    then return 2,"Mythic"    end
        if s:find("legendary") then return 1,"Legendary" end
        if s:find("epic")      then return 0.5,"Epic"    end
        if s:find("rare")      then return 0.3,"Rare"    end
        if s:find("uncommon")  then return 0.1,"Uncommon" end
        if s:find("common")    then return 0,"Common"    end
    end

    local score, name = check(rec.Rarity)
    if not score then score, name = check(tostring(rec.Uid or "")) end
    if not score then score, name = check(tostring(rec.AssetCategory or "")) end
    return score or 0, name or "Common"
end

