local function applyGodmode(state)
    h.godmode = state
    local c = lp.Character
    if not c then return end
    local hm = c:FindFirstChildOfClass("Humanoid")
    if hm then
        hm:SetStateEnabled(Enum.HumanoidStateType.Dead, not state)
        if state and hm.Health < 100 then hm.Health = 100 end
    end
    if state then
        for _, p in c:GetDescendants() do
            if p:IsA("BasePart") then
                p.CanTouch = false; p.CanCollide = false
            end
        end
    end
end

local function fixCharacter(c)
    c = c or lp.Character
    if not c then return end
    local hm = c:FindFirstChildOfClass("Humanoid")
    if hm then
        for _, s in {
            Enum.HumanoidStateType.Ragdoll,
            Enum.HumanoidStateType.FallingDown,
            Enum.HumanoidStateType.Physics,
            Enum.HumanoidStateType.PlatformStanding,
        } do pcall(function() hm:SetStateEnabled(s, false) end) end
        hm.PlatformStand = false
    end
    for _, p in c:GetDescendants() do
        if p:IsA("BallSocketConstraint") or p:IsA("HingeConstraint") or p:IsA("NoCollisionConstraint") then
            pcall(function() p:Destroy() end)
        end
    end
    for _, p in c:GetDescendants() do
        if p:IsA("Motor6D") and p.Part0 and p.Part1 then
            p.Enabled = true
            local wname = "VirexWeld_" .. p.Name
            if not p.Part1:FindFirstChild(wname) then
                local w = Instance.new("WeldConstraint")
                w.Name = wname; w.Part0 = p.Part0; w.Part1 = p.Part1; w.Parent = p.Part1
            end
        end
    end
end

