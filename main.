local function fetchSnapshot()
    if snapshotBusy then return end
    local remote = RF_EggSnapshot
    if not remote or not remote:IsA("RemoteFunction") then return end
    snapshotBusy = true
    task.spawn(function()
        local ok, res = pcall(function() return remote:InvokeServer() end)
        if ok and type(res) == "table" then
            local out = {}
            local recs = res.Records or res
            if type(recs) == "table" then
                for k, v in pairs(recs) do
                    if type(v) == "table" then
                        if not v.Uid and type(k) == "string" then v.Uid = k end
                        table.insert(out, v)
                    end
                end
            end
            if #out > 0 then
                snapshotCache = out
                snapshotTime  = os.clock()
            end
        end
        snapshotBusy = false
    end)
end

task.spawn(function()
    while h.alive do task.wait(1.5) pcall(fetchSnapshot) end
end)

local function getAllEggRecords(force)
    if force or (os.clock() - snapshotTime >= 1.5) or not snapshotCache then
        fetchSnapshot()
    end

    local records = {}
    local seen    = {}

    local function addRecord(r)
        if r.Uid and not seen[r.Uid] then
            seen[r.Uid] = true
            table.insert(records, r)
        end
    end

    -- Remote snapshot
    if snapshotCache then for _, r in snapshotCache do addRecord(r) end end

    -- EggState module
    if EggState and EggState.ReadFieldEggs then
        local ok, res = pcall(EggState.ReadFieldEggs)
        if ok and type(res) == "table" then
            local recs = res.Records or res
            for k, v in pairs(recs) do
                if type(v) == "table" then
                    if not v.Uid and type(k) == "string" then v.Uid = k end
                    addRecord(v)
                end
            end
        end
    end

    -- Physical slots
    local slots = Workspace:FindFirstChild("AreaEggSlotsClient")
    if slots then
        for _, child in slots:GetChildren() do
            local uid = child.Name
            if uid and uid ~= "" and not seen[uid] then
                local cf = child:GetPivot()
                if cf.Position.X >= 530 and not uid:find("FirstArea") then
                    seen[uid] = true
                    table.insert(records, {
                        Uid = uid,
                        AssetCategory = child:GetAttribute("Category") or child:GetAttribute("AssetCategory") or child.Name,
                        AreaId        = child:GetAttribute("AreaId") or child:GetAttribute("Area"),
                        Rarity        = child:GetAttribute("Rarity") or child:GetAttribute("RarityTier"),
                        State         = "Slot",
                        BoundsCFrame  = cf,
                        PhysicalModel = child,
                    })
                end
            else
                for _, rec in records do
                    if rec.Uid == uid and not rec.PhysicalModel then
                        rec.PhysicalModel = child
                        break
                    end
                end
            end
        end
    end

    return records
end

