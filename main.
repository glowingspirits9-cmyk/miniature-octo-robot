-- ┌─────────────────────────────────────────────┐
-- │  SMOOTH GLIDE ENGINE                        │
-- └─────────────────────────────────────────────┘
local function tweenTo(target, speed, uid, sessionCheck, timeout)
    if not refreshChar() then return false end
    timeout = timeout or 20
    speed   = math.max(60, speed or h.glideSpeed or 350)

    local root = hrp
    local hm   = hum
    if hm then hm.AutoRotate = false end

    spawnPad(target, 14)
    pcall(function() lp:RequestStreamAroundAsync(target) end)
    root.AssemblyLinearVelocity  = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    h.glidingToTarget = true
    local deadline = os.clock() + timeout

    while h.alive and h.glidingToTarget and os.clock() < deadline do
        if sessionCheck and sessionId ~= sessionCheck then
            h.glidingToTarget = false
            if hm then hm.AutoRotate = true end
            return false
        end
        if not h.pureTweenFarm and not h.autoFarmLoop and not h.teleporting then
            h.glidingToTarget = false
            if hm then hm.AutoRotate = true end
            return false
        end

        local pos  = root.Position
        local dist = (target - pos).Magnitude
        local xDist = math.abs(pos.X - target.X)
        local yDist = math.abs(pos.Y - target.Y)
        local hDist = (Vector2.new(pos.X, pos.Z) - Vector2.new(target.X, target.Z)).Magnitude

        if dist <= 6 or (hDist <= 3.5 and yDist <= 6) then break end

        -- check uid availability
        if uid and os.clock() % 0.5 < 0.08 then
            local slots = Workspace:FindFirstChild("AreaEggSlotsClient")
            if slots and not slots:FindFirstChild(tostring(uid)) then
                if snapshotCache then
                    local found = false
                    for _, r in snapshotCache do
                        if r.Uid == uid and (r.State == "Slot" or r.State == 1 or r.State == "Dropped") then
                            found = true; break
                        end
                    end
                    if not found then
                        h.glidingToTarget = false
                        if hm then hm.AutoRotate = true end
                        return false
                    end
                end
            end
        end

        local dt   = RunService.Heartbeat:Wait()
        pos        = root.Position

        local laneZ = h.laneZ or LANE_Z
        local targetZ = (xDist > 40) and laneZ or target.Z
        local spd = speed

        -- slow down in base area
        if pos.X <= FIELD_X and pos.X > SAFE_X then
            local t = math.clamp((pos.X - SAFE_X) / (FIELD_X - SAFE_X), 0, 1)
            spd = SLOW_SPEED + (speed - SLOW_SPEED) * t
        elseif pos.X <= SAFE_X then
            spd = SLOW_SPEED
        end

        local moveX = pos.X + math.sign(target.X - pos.X) * math.min(math.abs(target.X - pos.X), spd * dt)
        local moveY = pos.Y + math.sign(target.Y - pos.Y) * math.min(math.abs(target.Y - pos.Y), spd * dt * 0.5)
        local moveZ = pos.Z + math.sign(targetZ - pos.Z) * math.min(math.abs(targetZ - pos.Z), spd * dt)

        -- boss trap dodge
        local dodging = false
        for _, hb in getBossHitboxes() do
            local hp  = hb.Position
            local nxt = Vector3.new(moveX, moveY, moveZ)
            if (nxt - hp).Magnitude < 22 or (math.abs(moveX - hp.X) < 18 and math.abs(moveZ - hp.Z) < 14) then
                dodging = true
                local ceiling = hp.Y + 16
                if moveY < ceiling then moveY = math.min(moveY + spd * dt * 1.5, ceiling) end
                break
            end
        end

        local newPos = Vector3.new(moveX, moveY, moveZ)
        local look   = (newPos - pos).Magnitude > 0.05 and (newPos - pos).Unit or root.CFrame.LookVector
        root.CFrame  = CFrame.lookAt(newPos, newPos + look)
        root.AssemblyLinearVelocity  = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero

        h.statusText = dodging
            and string.format("Flying → Egg [DODGING] (%.0f st)", dist)
            or  string.format("Flying → Egg (%.0f st | %.0f sp)", dist, spd)
    end

    root.CFrame = CFrame.new(target) * CFrame.new(0, 0.4, 0)
    root.AssemblyLinearVelocity  = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    if hm then hm.AutoRotate = true end
    h.glidingToTarget = false
    return true
end

local function tweenHome(speed, sessionCheck, forced)
    if not refreshChar() then return false end
    speed   = math.max(100, speed or h.glideSpeed)
    local home = getPenPosition()
    local root = hrp
    local hm   = hum
    if hm then hm.AutoRotate = false end

    h.isReturning = true
    spawnPad(home, 20)
    root.AssemblyLinearVelocity = Vector3.zero

    local deadline = os.clock() + 30
    while h.alive and h.isReturning and os.clock() < deadline do
        if sessionCheck and sessionId ~= sessionCheck then
            h.isReturning = false
            if hm then hm.AutoRotate = true end
            return false
        end
        if not forced and not h.pureTweenFarm and not h.autoFarmLoop then
            h.isReturning = false
            if hm then hm.AutoRotate = true end
            return false
        end

        local pos  = root.Position
        local dist = (home - pos).Magnitude
        if (pos.X <= home.X + 3 and math.abs(pos.Z - home.Z) <= 8) or dist <= 6 then break end

        local dt  = RunService.Heartbeat:Wait()
        pos       = root.Position

        local laneZ = h.laneZ or LANE_Z
        local targetZ = pos.X > 540 and laneZ or home.Z
        local spd = speed
        if pos.X <= FIELD_X and pos.X > SAFE_X then
            local t = math.clamp((pos.X - SAFE_X) / (FIELD_X - SAFE_X), 0, 1)
            spd = SLOW_SPEED + (speed - SLOW_SPEED) * t
        elseif pos.X <= SAFE_X then spd = SLOW_SPEED end

        local moveX = pos.X + math.sign(home.X - pos.X) * math.min(math.abs(home.X - pos.X), spd * dt)
        local moveY = pos.Y + math.sign(home.Y - pos.Y) * math.min(math.abs(home.Y - pos.Y), spd * dt * 0.5)
        local moveZ = pos.Z + math.sign(targetZ - pos.Z) * math.min(math.abs(targetZ - pos.Z), spd * dt)

        for _, hb in getBossHitboxes() do
            local hp = hb.Position
            local nxt = Vector3.new(moveX, moveY, moveZ)
            if (nxt - hp).Magnitude < 22 then
                local ceil = hp.Y + 16
                if moveY < ceil then moveY = math.min(moveY + spd * dt * 1.5, ceil) end
                break
            end
        end

        local newPos = Vector3.new(moveX, moveY, moveZ)
        local look   = (newPos - pos).Magnitude > 0.05 and (newPos - pos).Unit or root.CFrame.LookVector
        root.CFrame  = CFrame.lookAt(newPos, newPos + look)
        root.AssemblyLinearVelocity  = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        h.statusText = string.format("Returning Home (%.0f st | X: %.0f)", dist, pos.X)
    end

    root.CFrame = CFrame.new(home)
    root.AssemblyLinearVelocity = Vector3.zero
    if hm then hm.AutoRotate = true end
    pcall(unequipAll)
    h.isReturning = false; h.delivering = false
    h.statusText = "At Base — Hands Free"
    return true
end

