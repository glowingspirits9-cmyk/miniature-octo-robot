    local page = makeTabPage()
    TAB_PAGES[btn] = {page = page, icon = iconLbl, name = nameLbl, pip = activePip}

    btn.MouseButton1Click:Connect(function()
        if ACTIVE_TAB == btn then return end
        if ACTIVE_TAB then
            local prev = TAB_PAGES[ACTIVE_TAB]
            tween(ACTIVE_TAB, 0.15, {BackgroundTransparency = 1})
            prev.icon.TextColor3 = PAL.sub
            prev.name.TextColor3 = PAL.sub
            prev.pip.Visible     = false
            prev.page.Visible    = false
        end
        ACTIVE_TAB = btn
        tween(btn, 0.15, {BackgroundTransparency = 0.7, BackgroundColor3 = PAL.card})
        iconLbl.TextColor3 = PAL.accent
        nameLbl.TextColor3 = PAL.text
        activePip.Visible  = true
        page.Visible       = true
    end)

    btn.MouseEnter:Connect(function()
        if ACTIVE_TAB ~= btn then tween(btn, 0.1, {BackgroundTransparency = 0.85, BackgroundColor3 = PAL.card}) end
    end)
    btn.MouseLeave:Connect(function()
        if ACTIVE_TAB ~= btn then tween(btn, 0.1, {BackgroundTransparency = 1}) end
    end)

    return page
end

