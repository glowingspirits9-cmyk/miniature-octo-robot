-- │  BEST EGG PICKER                            │
-- └─────────────────────────────────────────────┘
local function getBestEgg()
    local all = getAllEggRecords(false)
    if not all or #all == 0 then all = getAllEggRecords(true) end
    if not all or #all == 0 then return nil end

    local c = lp.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    local myPos = root and root.Position or Vector3.new(SAFE_X, 70, LANE_Z)

    local candidates = {}
    for _, rec in all do
        local state = rec.State
        local isAvail = (state == "Slot" or state == "Dropped" or state == 1 or state == "GuardCarried")
        if not isAvail then goto continue end
        if not rec.BoundsCFrame then goto continue end
        local pos = rec.BoundsCFrame.Position
        if pos.X < 530 then goto continue end
        if rec.Uid and skipList[rec.Uid] and os.clock() < skipList[rec.Uid] then goto continue end

        local score, rName = resolveRarity(rec)
        local zone = resolveZone(rec.AreaId, pos, rec.AssetCategory)
        local zWeight = ZONE_WEIGHT[zone] or 50

        -- filter check
        local isSecretPlus = score >= 4
        local zoneOK    = h.selectedZones[zone] == true
        local rarityOK  = h.selectedRarities[rName] == true
        local collect   = isSecretPlus or (zoneOK and rarityOK)
        if not collect then goto continue end

        local income = 0
        if AssetItems then
            pcall(function()
                if AssetItems.ProfileIncomePerSecond then
                    income = AssetItems.ProfileIncomePerSecond(rec.AssetCategory) or 0
                elseif AssetItems.Assets and AssetItems.Assets[rec.AssetCategory] then
                    local a = AssetItems.Assets[rec.AssetCategory]
                    income = a.EarningRate or (a.Egg and a.Egg.EarningRate) or 0
                end
            end)
        end

        local scale = tonumber(rec.AssetScale or rec.Scale) or 1
        local mutMult = 1
        if rec.Mutations and type(rec.Mutations) == "table" then
            for _, v in pairs(rec.Mutations) do
                mutMult *= ((type(v) == "table" and tonumber(v.Multiplier)) or tonumber(v) or 1.5)
            end
        elseif rec.Mutation then mutMult = 1.5 end

        local realIncome = income * scale * mutMult
        local dist       = (myPos - pos).Magnitude

        local sortScore
        if score >= 4 then
            sortScore = 400000 + score * 10000 + zWeight
        else
            sortScore = zWeight * 11 + score * 1000
        end

        table.insert(candidates, {
            rec        = rec,
            Uid        = rec.Uid,
            Category   = rec.AssetCategory or "Egg",
            Zone       = zone,
            Rarity     = rName,
            RarityScore = score,
            ZoneWeight = zWeight,
            SortScore  = sortScore,
            RealIncome = realIncome,
            Scale      = scale,
            Distance   = dist,
            Position   = pos,
            CFrame     = rec.BoundsCFrame,
            Model      = rec.PhysicalModel,
        })
        ::continue::
    end

    if #candidates == 0 then return nil end

    table.sort(candidates, function(a, b)
        if a.SortScore ~= b.SortScore then return a.SortScore > b.SortScore end
        if math.abs(a.RealIncome - b.RealIncome) > 1 then return a.RealIncome > b.RealIncome end
        return a.Distance < b.Distance
    end)

    local best = candidates[1]

    -- attach physical model from slots if missing
    if best and not best.Model then
        local slots = Workspace:FindFirstChild("AreaEggSlotsClient")
        if slots then
            for _, child in slots:GetChildren() do
                local p = child:FindFirstChildWhichIsA("BasePart") or child.PrimaryPart
                if p and (p.Position - best.Position).Magnitude <= 12 then
                    best.Model = child; break
                end
            end
        end
    end

    h.bestEggInfo = string.format("%s | %s | %s | %s/s | %.1fx | %dm",
        best.Category, best.Rarity, best.Zone,
        fmtMoney(best.RealIncome), best.Scale, math.floor(best.Distance))

    return best
end

