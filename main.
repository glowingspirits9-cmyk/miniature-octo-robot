        local dot = label(btn, "●", 12, state and color or PAL.sub, Enum.Font.GothamBold, Enum.TextXAlignment.Left)
        dot.Position = UDim2.new(0, 8, 0.5, -8)
        dot.Size     = UDim2.new(0, 14, 0, 16)

        local nameLbl = label(btn, zoneName, 11, state and PAL.text or PAL.sub, Enum.Font.Gotham)
        nameLbl.Position = UDim2.new(0, 24, 0, 0)
        nameLbl.Size     = UDim2.new(1, -28, 1, 0)
        nameLbl.TextTruncate = Enum.TextTruncate.AtEnd

        btn.MouseButton1Click:Connect(function()
            h.selectedZones[zoneName] = not h.selectedZones[zoneName]
            local on = h.selectedZones[zoneName]
            tween(btn, 0.15, {BackgroundColor3 = on and Color3.fromRGB(28,28,42) or PAL.card})
            dot.TextColor3 = on and color or PAL.sub
            nameLbl.TextColor3 = on and PAL.text or PAL.sub
        end)
    end

    return grid
end

local function addRarityGrid(page)
    local grid = Instance.new("Frame")
    grid.BackgroundTransparency = 1
    grid.Size = UDim2.new(1, 0, 0, 0)
    grid.AutomaticSize = Enum.AutomaticSize.Y
    grid.Parent = page

    local uiGrid = Instance.new("UIGridLayout")
    uiGrid.CellSize    = UDim2.new(0.33, -3, 0, 34)
    uiGrid.CellPadding = UDim2.new(0, 4, 0, 4)
    uiGrid.SortOrder   = Enum.SortOrder.LayoutOrder
    uiGrid.Parent      = grid

    for _, rarityName in RARITY_ORDER do
        local state = h.selectedRarities[rarityName] == true
        local color = RARITY_COLOR[rarityName] or PAL.accent

        local btn = Instance.new("TextButton")
        btn.BackgroundColor3 = state and Color3.fromRGB(28,28,42) or PAL.card
        btn.BorderSizePixel  = 0
        btn.Text   = ""
        btn.AutoButtonColor = false
        btn.Parent = grid
        corner(btn, 8)

        local nameLbl = label(btn, rarityName, 11, state and color or PAL.sub, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
        nameLbl.Size = UDim2.fromScale(1, 1)

        btn.MouseButton1Click:Connect(function()
            h.selectedRarities[rarityName] = not h.selectedRarities[rarityName]
            local on = h.selectedRarities[rarityName]
            tween(btn, 0.15, {BackgroundColor3 = on and Color3.fromRGB(28,28,42) or PAL.card})
            nameLbl.TextColor3 = on and color or PAL.sub
        end)
    end

    return grid
end

