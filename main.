local function isHoldingEgg(uid)
    local _, held = getHeldEgg()
    if held then return not uid or held == uid or true end
    local _, bp = getBackpackEgg()
    if bp then return not uid or bp == uid or true end
    -- check EggState
    if uid and EggState and EggState.ReadFieldEggs then
        local ok, res = pcall(EggState.ReadFieldEggs)
        if ok and type(res) == "table" then
            local recs = res.Records or res
            for _, r in pairs(recs) do
                if r.Uid == uid and (r.State == "Carried" or r.State == 2) then
                    return r.CarrierUserId == lp.UserId
                end
            end
        end
    end
    return false
end

local function guardStrike(uid, targetCF, model, sessionCheck)
    h.securingEgg      = true
    h.holdingEggForGuard = true
    h.stateTime        = os.clock()

    local function abort(reason)
        h.securingEgg        = false
        h.holdingEggForGuard = false
        h.currentTargetModel = nil
        h.targetPosition     = nil
        if uid then skipList[uid] = os.clock() + 3 end
        h.statusText = "[-] " .. reason
        return false
    end

    local pos = targetCF.Position
    spawnPad(pos, 14)
    if not refreshChar() then return abort("No character") end
    hrp.AssemblyLinearVelocity = Vector3.zero

    -- Phase 1: pick up egg
    h.statusText = "[Guard 1/4] Lifting egg..."
    local phase1 = os.clock() + 3.5
    local lastCarry = 0
    while not isHoldingEgg(uid) and os.clock() < phase1 and h.alive and h.securingEgg do
        if sessionCheck and sessionId ~= sessionCheck then return abort("Session switch P1") end
        lp.Character:PivotTo(targetCF * CFrame.new(0, 0.4, 0))
        firePrompts(model, pos)
        if uid and RF_CarryEgg and os.clock() - lastCarry > 0.35 then
            lastCarry = os.clock()
            task.spawn(function()
                pcall(function()
                    if RF_CarryEgg:IsA("RemoteFunction") then
                        RF_CarryEgg:InvokeServer({Uid = uid})
                        RF_CarryEgg:InvokeServer(uid)
                    else
                        RF_CarryEgg:FireServer({Uid = uid})
                        RF_CarryEgg:FireServer(uid)
                    end
                end)
            end)
        end
        RunService.Heartbeat:Wait()
    end

    if not isHoldingEgg(uid) then return abort("Phase 1 timeout") end

    -- Phase 2: wait for / trigger guard
    h.statusText = "[Guard 2/4] Guard strike..."
    local phase2 = os.clock() + 4.5
    local struckGuard = false
    while isHoldingEgg(uid) and os.clock() < phase2 and h.alive and h.securingEgg do
        if sessionCheck and sessionId ~= sessionCheck then return abort("Session switch P2") end
        lp.Character:PivotTo(targetCF * CFrame.new(0, 0.4, 0))
        spawnPad(pos, 14)
        if RE_GuardStrike and not struckGuard then
            task.spawn(function()
                pcall(function()
                    if RE_GuardStrike:IsA("RemoteFunction") then RE_GuardStrike:InvokeServer()
                    else RE_GuardStrike:FireServer() end
                end)
            end)
            struckGuard = true
        end
        RunService.Heartbeat:Wait()
    end

    -- Phase 3: re-grab
    h.statusText = "[Guard 3/4] Re-grabbing..."
    local phase3 = os.clock() + 3
    lastCarry = 0
    while not isHoldingEgg(uid) and os.clock() < phase3 and h.alive and h.securingEgg do
        if sessionCheck and sessionId ~= sessionCheck then return abort("Session switch P3") end
        lp.Character:PivotTo(targetCF * CFrame.new(0, 0.4, 0))
        firePrompts(model, pos)
        if uid and RF_CarryEgg and os.clock() - lastCarry > 0.35 then
            lastCarry = os.clock()
            task.spawn(function()
                pcall(function()
                    if RF_CarryEgg:IsA("RemoteFunction") then RF_CarryEgg:InvokeServer({Uid = uid}); RF_CarryEgg:InvokeServer(uid)
                    else RF_CarryEgg:FireServer({Uid = uid}); RF_CarryEgg:FireServer(uid) end
                end)
            end)
        end
        RunService.Heartbeat:Wait()
    end

    local secured = isHoldingEgg(uid)
    h.securingEgg        = false
    h.holdingEggForGuard = false
    h.currentTargetModel = nil
    h.targetPosition     = nil

    if secured then
        pcall(unequipAll)
        h.statusText = "[Guard 4/4] Secured! Stashed."
        return true
    else
        if uid then skipList[uid] = os.clock() + 3 end
