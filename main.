local function getBossHitboxes()
    local out = {}
    local debris = Workspace:FindFirstChild("__DEBRIS")
    if debris then
        for _, child in debris:GetChildren() do
            local hb = child:FindFirstChild("Hitbox")
            if hb and hb:IsA("BasePart") then table.insert(out, hb)
            elseif child:IsA("BasePart") and child.Name:lower():find("hitbox") then
                table.insert(out, child)
            end
        end
    end
    return out
